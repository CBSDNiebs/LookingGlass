rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    
    function isAuthenticated() {
       return request.auth != null;
    }
    
    function isAdmin() {
       return isAuthenticated() && (request.auth.token.email == 'jacobn@cbk12.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    
    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
       return isAuthenticated() && request.auth.uid == resource.data.uid;
    }
    
    function uidNotModified() {
       return !('uid' in request.resource.data) ||
         request.resource.data.uid == resource.data.uid;
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidObservation(data) {
      let allowedFields = ['uid', 'educatorName', 'school', 'mode', 'lessonTargetPosted', 'curriculaMaterialsUsed', 'durationMs', 'startedAt', 'stoppedAt', 'events', 'createdAt'];
      let allowedWithNotes = allowedFields.concat(['notes']);
      
      return (hasOnlyAllowedFields(allowedFields) || hasOnlyAllowedFields(allowedWithNotes)) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.educatorName is string && data.educatorName.size() > 0 && data.educatorName.size() < 100 &&
             data.school is string && data.school.size() > 0 && data.school.size() < 150 &&
             data.mode in ["OTRs", "Praise", "Engagement"] &&
             data.lessonTargetPosted in ["Yes", "No", "N/A"] &&
             data.curriculaMaterialsUsed in ["Yes", "No", "N/A"] &&
             data.durationMs is number && data.durationMs >= 0 &&
             data.startedAt is string && data.startedAt.size() > 0 && data.startedAt.size() < 50 &&
             data.stoppedAt is string && data.stoppedAt.size() > 0 && data.stoppedAt.size() < 50 &&
             data.events is list && data.events.size() <= 10000 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() < 50 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000));
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /observations/{observationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidObservation(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && isDocOwner() && isValidObservation(request.resource.data) && uidNotModified();
      allow delete: if isAuthenticated() && isDocOwner();
    }
  }
}

